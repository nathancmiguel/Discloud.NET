<Project>

  <!--
    Library dependencies target the lowest version that supports every target framework,
    so consumers are never forced onto a newer Microsoft.Extensions.* line than they use.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <!-- Test-only dependencies. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
  </ItemGroup>

</Project>
